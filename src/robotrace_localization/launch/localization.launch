<launch>
  <arg name="use_sim_time" default="true"/>
  <arg name="map_path" default="/ws/data/map_enu_v010.pcd"/>
  <arg name="metrics_path" default=""/>
  <arg name="nearest_neighbor_method" default="CPU_PARALLEL_KDTREE"/>
  <arg name="config" default="$(find robotrace_localization)/config/localization.yaml"/>
  <param name="use_sim_time" value="$(arg use_sim_time)"/>
  <rosparam command="load" file="$(arg config)"/>
  <include file="$(find fast_lio)/launch/odometry.launch"/>
  <!-- lio_imu and os_imu denote the same physical frame but have distinct TF names.
       Preserve the bag's os_sensor -> os_imu and os_sensor -> os_lidar edges. -->
  <!-- Read the same /mapping/extrinsic_T,R used by FAST-LIO. No second copy
       of the calibration is kept in this launch file. -->
  <node pkg="robotrace_localization" type="calibration_tf_node.py"
        name="lio_imu_to_lidar" output="screen" required="true"/>
  <node pkg="robotrace_localization" type="gnss_initializer_node"
        name="gnss_initializer" output="screen" required="true"/>
  <node pkg="robotrace_localization" type="gpu_map_localizer_node"
        name="gpu_map_localizer" output="screen" required="true">
    <param name="map_path" value="$(arg map_path)"/>
    <param name="metrics_path" value="$(arg metrics_path)"/>
    <param name="nearest_neighbor_method" value="$(arg nearest_neighbor_method)"/>
  </node>
</launch>
