# Normalize maintained text so shell entrypoints work after a Windows checkout.
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.cpp text eol=lf
*.cu text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.cuh text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.launch text eol=lf
*.json text eol=lf
*.rviz text eol=lf
CMakeLists.txt text eol=lf
Dockerfile* text eol=lf
docker/bashrc text eol=lf
LICENSE text eol=lf
NOTICE text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Keep retained upstream bytes and the manifest's original hashes intact.
src/fast_gicp/thirdparty/** -text -eol
src/fast_lio/include/IKFoM_toolkit/** -text -eol

# Recordings, point clouds, archives and binary artifacts are never normalized.
*.bag -text
*.bag.* -text
*.db3 -text
*.pcd -text
*.bin -text
*.so -text
*.a -text
*.png -text
*.jpg -text
*.pdf -text
*.zip -text
*.gz -text
*.zst -text
